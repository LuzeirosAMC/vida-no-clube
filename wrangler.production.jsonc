{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vida-no-clube",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "dist/client"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "luzeiros-vida-no-clube-db",
      "database_id": "9a92b3c6-af08-41c0-a8ac-501d6e246422"
    }
  ]
}
